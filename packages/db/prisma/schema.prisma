// =====================================================================
//  SWAA — database schema
//  منصة التحضير لاختبار الرخصة المهنية (الموجّه الطلابي / الإرشاد الطلابي)
//
//  Target: PostgreSQL 16+, Prisma 6.x (pinned; Prisma 7 moves `url` to prisma.config.ts)
//  Extensions: pg_trgm, vector (pgvector)
//  The database MUST be created with LC_CTYPE = C.UTF-8 or an ICU locale:
//  with LC_CTYPE=C, pg_trgm extracts zero trigrams from Arabic text.
//
//  Conventions
//  - ids are cuid strings; timestamps are UTC.
//  - Searchable Arabic text is stored twice: the canonical text (displayed)
//    and a `*Norm` search key produced by the shared normalizer
//    (packages/core/arabic ⇄ services/ingest). Search and dedup only use *Norm.
//  - Full-text (tsvector) and semantic (pgvector) indexes live in a separate
//    Postgres schema `search` that Prisma does not manage (tested: Prisma
//    Migrate would otherwise DROP raw HNSW/tsvector indexes as drift).
//    See prisma/sql/search_and_guards.sql. Trigram indexes are declared here.
//  - Deleting a user (PDPL erasure) must never be blocked: every relation to
//    User is either Cascade (personal learning data) or SetNull (records that
//    must outlive the person: purchases for ZATCA, audit, editorial trail).
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, vector]
}

// =====================================================================
//  1. Identity, consent, preferences
// =====================================================================

enum Role {
  STUDENT
  EDITOR // reviews / authors content
  EXPERT // subject-matter reviewer (second signature for measurement & regulation items)
  ADMIN // founder
}

enum Specialization {
  SOCIOLOGY
  SOCIAL_WORK
  PSYCHOLOGY
  EDUCATION
  OTHER
}

enum DigitStyle {
  ARABIC_INDIC // ١٢٣
  WESTERN // 123
}

model User {
  id             String          @id @default(cuid())
  name           String
  // Better Auth requires email. On soft delete it is replaced with
  // "deleted+<id>@invalid" so the address is freed and no longer stored.
  email          String          @unique
  emailVerified  Boolean         @default(false)
  phone          String?         @unique
  image          String?
  role           Role            @default(STUDENT)
  specialization Specialization?
  dailyMinutes   Int? // available study time per day
  placementDone  Boolean         @default(false)
  timezone       String          @default("Asia/Riyadh")
  digitStyle     DigitStyle      @default(ARABIC_INDIC)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime? // soft delete → hard-delete job within the retention window

  sessions          AuthSession[]
  accounts          AuthAccount[]
  examTargets       UserExamTarget[]
  consents          UserConsent[]
  notificationPrefs NotificationPreference[]
  pushSubscriptions PushSubscription[]
  exportRequests    DataExportRequest[]

  attempts       ExamAttempt[]
  answers        UserAnswer[]
  bookmarks      Bookmark[]
  reviewCards    WrongAnswer[]
  srsLogs        SrsReviewLog[]
  plans          StudyPlan[]
  studySessions  StudySession[]
  mastery        TopicProgress[]
  dailyActivity  DailyActivity[]
  reports        QuestionReport[] @relation("Reporter")
  conversations  AiConversation[]
  lessonProgress LessonProgress[]
  purchases      Purchase[]

  // staff-side (SetNull on delete)
  uploadedFiles      File[]             @relation("FileUploader")
  reviews            Review[]           @relation("Reviewer")
  authored           Question[]         @relation("QuestionAuthor")
  answerVerified     Question[]         @relation("AnswerVerifier")
  explanationChecked Question[]         @relation("ExplanationReviewer")
  revisions          QuestionRevision[]
  resolvedReports    QuestionReport[]   @relation("Resolver")
  auditLogs          AuditLog[]
}

// --- Better Auth core tables. Regenerate with `npx @better-auth/cli generate`
// --- whenever plugins change; field names must match exactly.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String // "credential" | "google" | "apple"
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum TargetStatus {
  PLANNED
  TAKEN
  PASSED
  FAILED
  ALREADY_PASSED // e.g. holds a valid التربوي العام result (5-year validity)
}

/// One row per test the student prepares for. The two tests have different
/// dates, so plans, FSRS interval caps and pass validity are per target.
model UserExamTarget {
  id        String        @id @default(cuid())
  userId    String
  trackId   String
  examDate  DateTime?     @db.Date
  status    TargetStatus  @default(PLANNED)
  attempt   Int           @default(1) // retakers keep history
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track         @relation(fields: [trackId], references: [id])
  purchases Purchase[]
  attempts  ExamAttempt[]

  @@index([userId, status])
}

enum ConsentKind {
  PRIVACY_POLICY
  TERMS
  MARKETING
  CROSS_BORDER_AI // AI processing outside the Kingdom (Claude API)
  ANALYTICS
}

/// Proof of consent under PDPL. Kept (with userId nulled) after erasure only
/// as long as legally required.
model UserConsent {
  id            String      @id @default(cuid())
  userId        String?
  kind          ConsentKind
  policyVersion String
  granted       Boolean
  at            DateTime    @default(now())
  withdrawnAt   DateTime?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
}

enum NotifyChannel {
  EMAIL
  WEB_PUSH
}

model NotificationPreference {
  userId  String
  channel NotifyChannel
  kind    String // "daily_plan", "review_due", "exam_countdown", "marketing"
  enabled Boolean       @default(true)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel, kind])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DataExportRequest {
  id        String    @id @default(cuid())
  userId    String
  status    String // queued | ready | expired
  fileKey   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================================
//  2. Taxonomy
//     Pedagogical tree:  Track → Category (مجال) → Topic (محور → موضوع)
//     Official tree:     Standard (مجال → معيار → مؤشر), versioned by Source
//     Cross-cutting:     Concept (مفهوم/مصطلح) + ConceptRelation
// =====================================================================

enum TrackCode {
  GENERAL // الاختبار التربوي العام
  COUNSELOR // الاختبار التخصصي: الإرشاد الطلابي (الوظيفة: الموجّه الطلابي)
}

model Track {
  id          String           @id @default(cuid())
  code        TrackCode        @unique
  nameAr      String
  description String?
  categories  Category[]
  questions   Question[]
  standards   Standard[]
  blueprints  ExamBlueprint[]
  templates   ExamTemplate[]
  targets     UserExamTarget[]
}

model Category {
  id             String          @id @default(cuid())
  trackId        String
  code           String // stable import code, e.g. "C2"
  nameAr         String
  // Provisional until read from the official applicant guide; mock exams may
  // only be labelled "محاكاة" when weightVerified = true.
  weight         Decimal?        @db.Decimal(5, 2)
  weightVerified Boolean         @default(false)
  weightSourceId String?
  order          Int             @default(0)
  track          Track           @relation(fields: [trackId], references: [id])
  weightSource   Source?         @relation("CategoryWeightSource", fields: [weightSourceId], references: [id], onDelete: SetNull)
  topics         Topic[]
  questions      Question[]
  blueprintItems BlueprintItem[]

  @@unique([trackId, code])
  @@unique([id, trackId]) // target of Question's composite FK
}

model Topic {
  id           String          @id @default(cuid())
  categoryId   String
  parentId     String?
  slug         String          @unique
  nameAr       String
  nameNorm     String
  nameEn       String?
  order        Int             @default(0)
  category     Category        @relation(fields: [categoryId], references: [id])
  parent       Topic?          @relation("TopicTree", fields: [parentId], references: [id])
  children     Topic[]         @relation("TopicTree")
  questions    Question[]      @relation("QuestionTopic")
  subQuestions Question[]      @relation("QuestionSubtopic")
  lessons      Lesson[]
  concepts     Concept[]
  progress     TopicProgress[]
  planTasks    StudyTask[]
  contentGaps  ContentGap[]

  @@unique([id, categoryId]) // target of Question's composite FK
  @@index([categoryId])
  @@index([parentId])
  @@index([nameNorm(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum ContentOrigin {
  FROM_SOURCE // taken from a file/regulation (with sourceRefs)
  TEAM_AUTHORED
  AI_DRAFTED // drafted by the model, then reviewed by a human
}

/// مفهوم/مصطلح. Shown to students (glossary, flashcards, contrasts), so it has
/// its own review status.
model Concept {
  id           String            @id @default(cuid())
  topicId      String?
  nameAr       String
  nameEn       String? // e.g. "Response cost"
  nameNorm     String            @unique
  definition   String?
  examples     Json? // ["موقف قصير يمثل المفهوم", …]
  nonExamples  Json? // ["موقف يشبهه لكنه ليس هو", …]
  sourceRefs   Json? // [{sourceId, page}]
  origin       ContentOrigin     @default(TEAM_AUTHORED)
  status       ContentStatus     @default(DRAFT)
  topic        Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions    QuestionConcept[]
  lessons      LessonConcept[]
  relationsOut ConceptRelation[] @relation("From")
  relationsIn  ConceptRelation[] @relation("To")
  reviews      Review[]
  regulations  RegulationLink[]

  @@index([topicId])
  @@index([nameNorm(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum ConceptRelationType {
  CONFUSABLE_WITH // تكلفة الاستجابة ↔ العقاب السلبي ↔ الإقصاء
  PART_OF
  OPPOSITE_OF
  SAME_AS // used to merge duplicates
}

model ConceptRelation {
  fromId String
  toId   String
  type   ConceptRelationType
  // distinguishing rules shown in "مفاهيم متشابهة":
  // [{"cue": "يُسحب الطالب من بيئة التعزيز", "points_to": "<conceptId>"}]
  rules  Json?
  status ContentStatus       @default(DRAFT)
  from   Concept             @relation("From", fields: [fromId], references: [id], onDelete: Cascade)
  to     Concept             @relation("To", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, type])
  @@index([toId])
}

/// Domain synonyms for search and dedup keys: المرشد ↔ الموجه، الإرشاد ↔ التوجيه…
/// Each normalized term belongs to exactly one group.
model SearchSynonym {
  id       String  @id @default(cuid())
  termNorm String  @unique
  groupKey String
  note     String?

  @@index([groupKey])
}

enum StandardLevel {
  DOMAIN // مجال
  STANDARD // معيار
  INDICATOR // مؤشر
}

/// Official ETEC framework, versioned by the document it comes from. Kept apart
/// from Topic so questions can be re-mapped when new standards are published.
model Standard {
  id             String             @id @default(cuid())
  trackId        String
  sourceId       String
  parentId       String?
  level          StandardLevel
  code           String
  textAr         String
  weight         Decimal?           @db.Decimal(5, 2)
  verified       Boolean            @default(false) // true only after reading the official PDF
  track          Track              @relation(fields: [trackId], references: [id])
  source         Source             @relation(fields: [sourceId], references: [id])
  parent         Standard?          @relation("StandardTree", fields: [parentId], references: [id])
  children       Standard[]         @relation("StandardTree")
  questions      QuestionStandard[]
  blueprintItems BlueprintItem[]

  @@unique([sourceId, code])
  @@index([parentId])
}

enum MappingConfidence {
  CONFIRMED // checked against the official indicator text
  TENTATIVE // "ربط غير مؤكد بالمعايير"
}

model QuestionStandard {
  questionId String
  standardId String
  isPrimary  Boolean           @default(false)
  confidence MappingConfidence @default(TENTATIVE)
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  standard   Standard          @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([questionId, standardId])
  @@index([standardId])
}

// =====================================================================
//  3. Sources, files, ingestion
// =====================================================================

enum SourceType {
  OFFICIAL // ETEC / Ministry published material
  REGULATION // قواعد السلوك والمواظبة، الأدلة التنظيمية… (versioned)
  RECALLED_EXAM // استرجاع: questions remembered by candidates
  COMPILATION // تجميعات (re-aggregations of recalls)
  THIRD_PARTY_PRACTICE // تدريبي: practice questions written by others, not from an exam
  STUDY_NOTES // ملخص/مذكرة/ملزمة
  BOOK
  TEAM_AUTHORED
  AI_GENERATED
}

enum SourceRights {
  OWNED // written by the founder/team
  OFFICIAL_PUBLIC // government publications: cite, quote briefly
  PERMITTED // explicit permission from the author
  ANALYSIS_ONLY // topics & frequency only; items are never published verbatim
}

enum ExamEra {
  KAFAYAT_PRE_1441 // اختبار الكفايات / قياس القديم
  LICENSE_1441_ON // الرخصة المهنية
}

model Source {
  id             String       @id @default(cuid())
  type           SourceType
  title          String
  author         String?
  yearHijri      Int?
  yearGreg       Int?
  examEra        ExamEra? // for RECALLED_EXAM / COMPILATION
  sittingLabel   String? // e.g. "1440-الدور الأول": frequency counts distinct sittings
  reliability    Int          @default(3) // 1..5, founder's judgement
  url            String?
  notes          String?
  // edition registry
  issuer         String?
  edition        String?
  isCurrent      Boolean      @default(true)
  supersededById String?
  // lineage: a compilation that reprints another source is NOT independent evidence
  derivedFromId  String?
  rights         SourceRights @default(ANALYSIS_ONLY)
  createdAt      DateTime     @default(now())

  supersededBy    Source?              @relation("Supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      Source[]             @relation("Supersedes")
  derivedFrom     Source?              @relation("Lineage", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives     Source[]             @relation("Lineage")
  files           File[]
  occurrences     QuestionOccurrence[]
  chunks          ContentChunk[]
  standards       Standard[]
  categoryWeights Category[]           @relation("CategoryWeightSource")
  answerRefs      Question[]           @relation("AnswerReference")
  regulationLinks RegulationLink[]
  suggestedFor    ExtractedQuestion[]  @relation("SuggestedRegulation")
  blueprints      ExamBlueprint[]

  @@index([type])
  @@index([derivedFromId])
}

/// A question, lesson or concept whose correctness depends on a regulation
/// edition. Superseding that edition flags every linked item for review.
model RegulationLink {
  id         String    @id @default(cuid())
  sourceId   String
  questionId String?
  lessonId   String?
  conceptId  String?
  source     Source    @relation(fields: [sourceId], references: [id])
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lesson     Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept    Concept?  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([questionId])
}

enum FileStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  ANALYZING
  IN_REVIEW
  DONE
  FAILED
}

model File {
  id           String               @id @default(cuid())
  sourceId     String?
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String               @unique
  storageKey   String // private object-storage key
  pageCount    Int?
  status       FileStatus           @default(UPLOADED)
  stats        Json?
  uploadedById String?
  createdAt    DateTime             @default(now())
  source       Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  uploadedBy   User?                @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  runs         IngestionRun[]
  jobs         IngestionJob[]
  chunks       ContentChunk[]
  extracted    ExtractedQuestion[]
  occurrences  QuestionOccurrence[]

  @@index([sourceId])
}

/// One processing pass over a file. Re-processing creates a new run and marks
/// the old one superseded: nothing is deleted, so reviews and citations survive.
model IngestionRun {
  id              String              @id @default(cuid())
  fileId          String
  pipelineVersion String
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  supersededAt    DateTime?
  file            File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  jobs            IngestionJob[]
  chunks          ContentChunk[]
  extracted       ExtractedQuestion[]

  @@index([fileId])
}

enum JobStage {
  EXTRACT_TEXT // text layer / OCR + quality gate
  NORMALIZE // two-layer Arabic normalization, noise & PII stripping
  SEGMENT // chunks + chunk kind
  EXTRACT_ITEMS // questions, concepts, key points (LLM, structured output)
  CLASSIFY // Category/Topic/Concept/Standard, difficulty
  EMBED // embeddings (needed by DEDUPE and RAG)
  DEDUPE // exact → trigram/embedding candidates → LLM opinion → human
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Postgres-backed queue (SELECT … FOR UPDATE SKIP LOCKED).
model IngestionJob {
  id              String              @id @default(cuid())
  fileId          String
  runId           String
  stage           JobStage
  status          JobStatus           @default(QUEUED)
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(3)
  runAfter        DateTime            @default(now())
  lockedBy        String?
  lockedUntil     DateTime?
  externalBatchId String? // Claude Message Batches id
  error           String?
  metrics         Json? // tokens, cost, durations
  createdAt       DateTime            @default(now())
  finishedAt      DateTime?
  file            File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  run             IngestionRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  extracted       ExtractedQuestion[]

  @@index([status, runAfter])
  @@index([fileId])
  @@index([runId])
}

enum ChunkKind {
  QUESTION_BLOCK
  EXPLANATION
  STUDY_CONTENT
  ADVICE // candidate tips: metadata only
  NOISE
}

enum ExtractionMethod {
  DOCX
  PDF_TEXT // PyMuPDF text layer that passed the quality gate
  VISION_LLM // Claude on the rendered page image
  TESSERACT
  PPTX
  TELEGRAM_EXPORT
  MANUAL
}

/// Page/section-level text; the unit of citation for the AI tutor.
model ContentChunk {
  id           String              @id @default(cuid())
  fileId       String
  runId        String
  sourceId     String?
  page         Int?
  ordinal      Int
  kind         ChunkKind?
  method       ExtractionMethod
  pageImageKey String? // rendered page for the review screen
  textRaw      String
  textNorm     String
  quality      Float? // 0..1
  // tsvector + embedding: search.chunk_index (outside Prisma)
  file         File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  run          IngestionRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  source       Source?             @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  extracted    ExtractedQuestion[]

  @@index([fileId, page])
  @@index([runId])
}

// =====================================================================
//  4. Staging: what the pipeline found, before a human decides
// =====================================================================

enum AnswerStatus {
  IN_SOURCE // the file states the answer explicitly (answerEvidence holds the span)
  CANDIDATE_REPORTED // "اخترت النفسي": a candidate's choice, NOT a key
  MISSING // no answer in the file: never auto-filled
  DISPUTED // sources disagree
}

enum PublishPolicy {
  PUBLISH_AS_IS // OWNED / OFFICIAL_PUBLIC / PERMITTED, wording kept
  PUBLISH_REWRITTEN // reworded by the team, key verified against a reference
  CONCEPT_SIGNAL_ONLY // ANALYSIS_ONLY: counts toward concept frequency, never published
}

enum ExtractionStatus {
  PENDING
  NEEDS_AUTHORING // must be rewritten / options or explanation authored before approval
  NEEDS_EDIT
  APPROVED // → new Question
  MERGED // → occurrence of an existing Question
  SIGNAL_ONLY // kept as concept-frequency evidence
  REJECTED
}

model ExtractedQuestion {
  id                          String           @id @default(cuid())
  fileId                      String
  runId                       String
  jobId                       String?
  chunkId                     String?
  page                        Int?
  rawExcerpt                  String // verbatim span from the file
  stem                        String // cleaned stem (فصحى), editable
  stemNorm                    String
  options                     Json // [{text, fromSource: bool}]
  optionsComplete             Boolean // false when "ناسي الخيارات"
  answerText                  String? // only if found in the file
  answerStatus                AnswerStatus
  answerEvidence              String? // exact span that states the answer
  aiSuggestedAnswer           String? // REVIEWERS ONLY, clearly labeled
  aiSuggestedWhy              String?
  explanation                 String? // only if present in the file
  suggestedTopicId            String?
  suggestedConcepts           Json?
  suggestedRegulationSourceId String?
  difficultyGuess             Int?
  confidence                  Float
  flags                       String[] // dialect, partial_options, outdated_regulation, image_missing, pii_removed…
  model                       String? // e.g. "claude-opus-5-5"
  promptVersion               String?
  // embedding: search.extracted_index (outside Prisma)
  clusterKey                  String?
  nearestQuestionId           String?
  similarity                  Float?
  priority                    Float? // review order: concept frequency × standard coverage × confidence
  publishPolicy               PublishPolicy?
  status                      ExtractionStatus @default(PENDING)
  publishedQuestionId         String?
  createdAt                   DateTime         @default(now())

  file                File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  run                 IngestionRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  job                 IngestionJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  chunk               ContentChunk?       @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  suggestedRegulation Source?             @relation("SuggestedRegulation", fields: [suggestedRegulationSourceId], references: [id], onDelete: SetNull)
  nearestQuestion     Question?           @relation("NearestMatch", fields: [nearestQuestionId], references: [id], onDelete: SetNull)
  publishedQuestion   Question?           @relation("PublishedFrom", fields: [publishedQuestionId], references: [id], onDelete: SetNull)
  occurrence          QuestionOccurrence?
  reviews             Review[]

  @@index([status, priority])
  @@index([fileId])
  @@index([runId])
  @@index([clusterKey])
}

enum ReviewTarget {
  EXTRACTED_QUESTION
  QUESTION
  LESSON
  CONCEPT
}

enum ReviewDecision {
  APPROVE
  APPROVE_WITH_EDITS
  MERGE
  SIGNAL_ONLY
  REJECT
  REQUEST_ANSWER_VERIFICATION
  REQUEST_EXPERT_REVIEW
}

/// Editorial trail. Reviewer is SetNull so erasing a staff account keeps the decision.
model Review {
  id                  String             @id @default(cuid())
  target              ReviewTarget
  extractedQuestionId String?
  questionId          String?
  lessonId            String?
  conceptId           String?
  reviewerId          String?
  decision            ReviewDecision
  notes               String?
  diff                Json?
  createdAt           DateTime           @default(now())
  reviewer            User?              @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  extracted           ExtractedQuestion? @relation(fields: [extractedQuestionId], references: [id], onDelete: Cascade)
  question            Question?          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lesson              Lesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept             Concept?           @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([extractedQuestionId])
  @@index([questionId])
}

// =====================================================================
//  5. Question bank (published content)
// =====================================================================

enum QuestionType {
  MCQ
  SCENARIO // موقف + MCQ
  TRUE_FALSE
  IMAGE_BASED // chart/graph
}

/// How the WORDING was produced (shown as a badge, together with an evidence
/// badge derived from occurrences' Source.type).
enum QuestionOrigin {
  SOURCE_VERBATIM // wording taken from an OWNED/OFFICIAL/PERMITTED source
  BASED_ON_RECALL // "مبني على استرجاع: الصياغة والخيارات من إعدادنا"
  ADAPTED // new wording of an earlier question (parentQuestionId)
  TEAM_AUTHORED
  AI_GENERATED // drafted by the model, reviewed by a human before publishing
}

/// Where the answer key comes from. Publishing is blocked for anything else.
enum AnswerBasis {
  IN_SOURCE_FILE // the file states it AND rights allow using it
  REFERENCE_VERIFIED // a reviewer checked it against answerRefSource
  EDITOR_KEYED // team-authored item, keyed by its author + second reviewer
  AI_SUGGESTED_VERIFIED // model suggestion, then verified against a reference
}

enum AnswerConfidence {
  VERIFIED // checked against an official/regulatory/academic reference
  CONSENSUS // independent sources agree
  SINGLE_SOURCE
  DISPUTED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ItemPool {
  PRACTICE // bank, lessons, mistake review
  MOCK // reserved for mock exams
  PLACEMENT // reserved for placement
}

enum ExplanationOrigin {
  FROM_SOURCE
  TEAM_AUTHORED
  AI_DRAFTED // reviewed before publishing
}

/// Questions that test the same thing (variants). FSRS cards and mock-exam
/// assembly work per family: one family per attempt, a sibling on each review.
model ItemFamily {
  id        String         @id @default(cuid())
  label     String?
  questions Question[]
  cards     WrongAnswer[]
  srsLogs   SrsReviewLog[]
}

model Question {
  id         String       @id @default(cuid())
  trackId    String
  categoryId String
  topicId    String
  subtopicId String?
  familyId   String
  type       QuestionType @default(MCQ)
  stem       String
  stemNorm   String
  mediaKey   String?
  difficulty Int          @default(3) // 1..5 editorial
  pool       ItemPool     @default(PRACTICE)

  // provenance of wording and key
  origin             QuestionOrigin
  parentQuestionId   String? // ADAPTED provenance only
  keyNotInSource     Boolean          @default(false) // correct option was authored, not recalled
  answerBasis        AnswerBasis
  answerConfidence   AnswerConfidence
  answerRefSourceId  String?
  answerRefPage      String?
  answerVerifiedById String?
  answerVerifiedAt   DateTime?
  // Only scorable items count in placement, mocks, mastery and FSRS.
  // The publish service sets it: answerConfidence ∈ {VERIFIED, CONSENSUS}.
  scorable           Boolean          @default(false)

  // explanation
  explanation             String
  explanationOrigin       ExplanationOrigin
  explanationReviewedById String?
  reference               String? // human-readable citation shown under the explanation

  // AI provenance (origin = AI_GENERATED)
  generatorModel        String?
  promptVersion         String?
  generatedAt           DateTime?
  generatedFromChunkIds String[]

  // lifecycle
  status       ContentStatus @default(DRAFT)
  needsReview  Boolean       @default(false) // e.g. its regulation was superseded
  reviewReason String?
  isPremium    Boolean       @default(true)
  version      Int           @default(1)
  createdById  String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // nightly statistics (first-exposure answers only)
  attemptsCount  Int    @default(0)
  correctRate    Float?
  avgTimeMs      Int?
  discrimination Float?

  // tsvector + embedding: search.question_index (outside Prisma)

  track                 Track      @relation(fields: [trackId], references: [id])
  // composite FKs keep track/category consistent with the topic
  category              Category   @relation(fields: [categoryId, trackId], references: [id, trackId])
  topic                 Topic      @relation("QuestionTopic", fields: [topicId, categoryId], references: [id, categoryId])
  subtopic              Topic?     @relation("QuestionSubtopic", fields: [subtopicId], references: [id], onDelete: SetNull)
  family                ItemFamily @relation(fields: [familyId], references: [id])
  parent                Question?  @relation("Variants", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  variants              Question[] @relation("Variants")
  answerRefSource       Source?    @relation("AnswerReference", fields: [answerRefSourceId], references: [id], onDelete: Restrict)
  answerVerifiedBy      User?      @relation("AnswerVerifier", fields: [answerVerifiedById], references: [id], onDelete: SetNull)
  explanationReviewedBy User?      @relation("ExplanationReviewer", fields: [explanationReviewedById], references: [id], onDelete: SetNull)
  createdBy             User?      @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  options       AnswerOption[]
  concepts      QuestionConcept[]
  standards     QuestionStandard[]
  occurrences   QuestionOccurrence[]
  revisions     QuestionRevision[]
  regulations   RegulationLink[]
  answers       UserAnswer[]
  bookmarks     Bookmark[]
  reports       QuestionReport[]
  reviews       Review[]
  publishedFrom ExtractedQuestion[]  @relation("PublishedFrom")
  nearestFor    ExtractedQuestion[]  @relation("NearestMatch")
  srsLogs       SrsReviewLog[]
  lastShownIn   WrongAnswer[]        @relation("LastShown")

  @@index([trackId, categoryId, topicId, status])
  @@index([status, pool, scorable])
  @@index([familyId])
  @@index([parentQuestionId])
  @@index([answerRefSourceId])
  @@index([stemNorm(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Options are never deleted once answered: edit text in place or retire.
model AnswerOption {
  id         String       @id @default(cuid())
  questionId String
  label      String // أ ب ج د (display only; order is shuffled per attempt)
  text       String
  isCorrect  Boolean      @default(false) // exactly one per MCQ: partial unique index
  fromSource Boolean      @default(false) // option text came from the source file
  whyWrong   String?
  order      Int
  retiredAt  DateTime?
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers    UserAnswer[]

  @@index([questionId])
}

model QuestionConcept {
  questionId String
  conceptId  String
  isPrimary  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@index([conceptId])
}

/// Every place a question was seen. "Frequency" = COUNT(DISTINCT lineage root
/// × sitting) over occurrences whose source is RECALLED_EXAM/COMPILATION;
/// shown to students at CONCEPT level only, never as a promise.
model QuestionOccurrence {
  id                  String             @id @default(cuid())
  questionId          String
  sourceId            String
  fileId              String?
  page                Int?
  yearHijri           Int?
  rawExcerpt          String
  extractedQuestionId String?            @unique
  question            Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)
  source              Source             @relation(fields: [sourceId], references: [id])
  file                File?              @relation(fields: [fileId], references: [id], onDelete: SetNull)
  extracted           ExtractedQuestion? @relation(fields: [extractedQuestionId], references: [id], onDelete: SetNull)

  @@unique([questionId, sourceId])
  @@index([sourceId])
}

model QuestionRevision {
  id           String           @id @default(cuid())
  questionId   String
  version      Int
  snapshot     Json
  editedById   String?
  reason       String?
  createdAt    DateTime         @default(now())
  question     Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  editedBy     User?            @relation(fields: [editedById], references: [id], onDelete: SetNull)
  fixedReports QuestionReport[]

  @@unique([questionId, version])
}

enum ReportReason {
  UNCLEAR
  WRONG_ANSWER
  TYPO
  OUTDATED
  DUPLICATE
  OTHER
}

enum ReportStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

model QuestionReport {
  id           String            @id @default(cuid())
  questionId   String
  userId       String? // SetNull: the QA trail survives the reporter's erasure
  reason       ReportReason
  message      String?
  status       ReportStatus      @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  revisionId   String? // the revision that fixed it → drives regrading
  createdAt    DateTime          @default(now())
  question     Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User?             @relation("Reporter", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy   User?             @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  revision     QuestionRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([questionId])
}

// =====================================================================
//  6. Study content (ذاكر + المراجعة المكثفة)
// =====================================================================

enum LessonKind {
  TOPIC_LESSON
  WORKED_SCENARIO // موقف محلول خطوة بخطوة + النظام الحاكم وإصداره
  CONTRAST // الفرق بين…
  COMMON_MISTAKES
  INTENSIVE
}

model Lesson {
  id          String           @id @default(cuid())
  topicId     String
  kind        LessonKind       @default(TOPIC_LESSON)
  title       String
  titleNorm   String
  body        String // MDX (Arabic)
  bodyNorm    String
  keyPoints   Json
  sourceRefs  Json? // [{sourceId, page}]
  origin      ContentOrigin    @default(TEAM_AUTHORED)
  readMinutes Int              @default(5)
  order       Int              @default(0)
  status      ContentStatus    @default(DRAFT)
  updatedAt   DateTime         @updatedAt
  topic       Topic            @relation(fields: [topicId], references: [id])
  concepts    LessonConcept[]
  progress    LessonProgress[]
  reviews     Review[]
  regulations RegulationLink[]

  @@index([topicId])
  @@index([titleNorm(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum LessonConceptRole {
  TEACHES
  CONTRASTS
  MENTIONS
}

model LessonConcept {
  lessonId  String
  conceptId String
  role      LessonConceptRole @default(TEACHES)
  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept   Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([lessonId, conceptId])
  @@index([conceptId])
}

model LessonProgress {
  userId      String
  lessonId    String
  completedAt DateTime?
  lastOpened  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// =====================================================================
//  7. Blueprints, exams, attempts
// =====================================================================

/// Question count, duration and weights of a test, versioned by the document
/// they come from. `verified=false` → the UI must not call the mock a simulation.
model ExamBlueprint {
  id            String          @id @default(cuid())
  trackId       String
  sourceId      String?
  edition       String?
  verified      Boolean         @default(false)
  questionCount Int
  durationSec   Int
  isActive      Boolean         @default(true)
  track         Track           @relation(fields: [trackId], references: [id])
  source        Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items         BlueprintItem[]
  templates     ExamTemplate[]
}

model BlueprintItem {
  id          String        @id @default(cuid())
  blueprintId String
  categoryId  String?
  standardId  String?
  weightPct   Decimal?      @db.Decimal(5, 2)
  count       Int?
  blueprint   ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id])
  standard    Standard?     @relation(fields: [standardId], references: [id])

  @@index([blueprintId])
}

enum ExamKind {
  PLACEMENT
  GENERAL_MOCK
  COUNSELOR_MOCK
  FULL_MOCK
  QUICK
  TOPIC
  CUSTOM
  PRACTICE // bank session
  REVIEW // mistake-review session
  LESSON_QUIZ
}

model ExamTemplate {
  id               String         @id @default(cuid())
  trackId          String?
  blueprintId      String?
  kind             ExamKind
  title            String
  questionCount    Int
  durationSec      Int?
  shuffleQuestions Boolean        @default(true)
  shuffleOptions   Boolean        @default(true)
  showFeedback     Boolean        @default(false)
  isActive         Boolean        @default(true)
  track            Track?         @relation(fields: [trackId], references: [id])
  blueprint        ExamBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  attempts         ExamAttempt[]
}

enum AttemptStatus {
  IN_PROGRESS
  PAUSED // placement can be paused and resumed
  SUBMITTED
  EXPIRED
  ABANDONED
}

/// Every answering session (including bank practice) is an attempt, so every
/// UserAnswer has an attemptId and autosave is idempotent.
model ExamAttempt {
  id            String          @id @default(cuid())
  userId        String
  templateId    String?
  targetId      String?
  kind          ExamKind
  config        Json // snapshot: count, duration, filters, seed
  questionOrder String[]
  status        AttemptStatus   @default(IN_PROGRESS)
  startedAt     DateTime        @default(now())
  deadlineAt    DateTime? // server-authoritative timer
  pausedAt      DateTime?
  remainingMs   Int? // stored while PAUSED
  submittedAt   DateTime?
  durationSec   Int?
  totalCount    Int
  correctCount  Int?
  scorePct      Float? // percent correct: never shown on the official 0–100 scale
  breakdown     Json?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      ExamTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  target        UserExamTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  answers       UserAnswer[]

  @@index([userId, kind, startedAt])
}

enum SelfConfidence {
  SURE
  UNSURE
  GUESS
}

model UserAnswer {
  id               String          @id @default(cuid())
  userId           String
  questionId       String
  questionVersion  Int // grading key version → regrade after a key fix
  attemptId        String
  clientAnswerId   String          @unique // client UUID: retries after reconnect are idempotent
  selectedOptionId String?
  isCorrect        Boolean
  selfConfidence   SelfConfidence?
  timeMs           Int?
  optionOrder      String[]
  flagged          Boolean         @default(false)
  firstExposure    Boolean // only first exposures feed mastery & item statistics
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  attempt          ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  selectedOption   AnswerOption?   @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)
  srsLog           SrsReviewLog?

  @@unique([attemptId, questionId])
  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([questionId, selectedOptionId]) // distractor analysis
}

enum BookmarkKind {
  FAVORITE
  FLAGGED
}

model Bookmark {
  userId     String
  questionId String
  kind       BookmarkKind
  note       String?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId, kind])
}

// =====================================================================
//  8. Smart mistake review (FSRS-6 via ts-fsrs), per item family
// =====================================================================

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum CardEntryReason {
  WRONG
  GUESSED_CORRECT
}

/// "WrongAnswers": one card per (user, item family). Each return shows a
/// sibling question with shuffled options; the maximum interval is capped at
/// the days left before the relevant exam target.
model WrongAnswer {
  userId         String
  familyId       String
  lastQuestionId String?
  entryReason    CardEntryReason
  state          CardState       @default(NEW)
  due            DateTime        @default(now())
  stability      Float           @default(0)
  difficulty     Float           @default(0)
  elapsedDays    Int             @default(0)
  scheduledDays  Int             @default(0)
  learningSteps  Int             @default(0)
  reps           Int             @default(0)
  lapses         Int             @default(0)
  lastReviewAt   DateTime?
  firstSeenAt    DateTime        @default(now())
  wrongCount     Int             @default(0)
  masteredAt     DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  family         ItemFamily      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  lastQuestion   Question?       @relation("LastShown", fields: [lastQuestionId], references: [id], onDelete: SetNull)

  @@id([userId, familyId])
  @@index([userId, masteredAt, due])
}

enum SrsRating {
  AGAIN
  HARD
  GOOD
  EASY
}

/// Every review, for auditing and per-user FSRS parameter optimization.
model SrsReviewLog {
  id            String      @id @default(cuid())
  userId        String
  familyId      String
  questionId    String
  userAnswerId  String?     @unique
  rating        SrsRating
  stateBefore   CardState
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  reviewedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  family        ItemFamily  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer    UserAnswer? @relation(fields: [userAnswerId], references: [id], onDelete: SetNull)

  @@index([userId, reviewedAt])
}

// =====================================================================
//  9. Progress, plans, sessions
// =====================================================================

/// Mastery per topic, from first-exposure, interleaved answers only.
/// Shown as "غير كافٍ للحكم" until `attempts` reaches the reliability threshold.
model TopicProgress {
  userId        String
  topicId       String
  mastery       Float     @default(0)
  attempts      Int       @default(0)
  correct       Int       @default(0)
  lastPracticed DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

model DailyActivity {
  userId    String
  date      DateTime @db.Date
  questions Int      @default(0)
  correct   Int      @default(0)
  minutes   Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

enum PlanStatus {
  ACTIVE
  REPLACED
  COMPLETED
}

/// Deadlines come from the user's exam targets (one plan can cover both tests).
model StudyPlan {
  id           String         @id @default(cuid())
  userId       String
  startDate    DateTime       @db.Date
  dailyMinutes Int
  inputs       Json // snapshot: targets + dates, placement result, weak domains
  status       PlanStatus     @default(ACTIVE)
  version      Int            @default(1)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days         StudyPlanDay[]

  @@index([userId, status])
}

model StudyPlanDay {
  id       String      @id @default(cuid())
  planId   String
  date     DateTime    @db.Date
  dayIndex Int
  theme    String?
  plan     StudyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks    StudyTask[]

  @@unique([planId, date])
}

enum TaskType {
  LESSON
  PRACTICE
  REVIEW_MISTAKES
  MOCK_EXAM
  FLASHCARDS
  INTENSIVE_REVIEW
  REST
}

model StudyTask {
  id          String         @id @default(cuid())
  dayId       String
  type        TaskType
  trackCode   TrackCode?
  topicId     String?
  targetCount Int?
  minutes     Int
  completedAt DateTime?
  day         StudyPlanDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  topic       Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sessions    StudySession[]

  @@index([dayId])
}

model StudySession {
  id        String     @id @default(cuid())
  userId    String
  taskId    String?
  activity  ExamKind?
  startedAt DateTime   @default(now())
  endedAt   DateTime?
  minutes   Int?
  questions Int        @default(0)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      StudyTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

// =====================================================================
// 10. AI tutor
// =====================================================================

model AiConversation {
  id         String      @id @default(cuid())
  userId     String
  questionId String?
  topicId    String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([userId, createdAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        Json // full content blocks, kept verbatim
  citations      Json? // [{chunkId, sourceTitle, page, quote}]
  grounded       Boolean        @default(true) // false → refused or labeled "غير موثق في مصادر المنصة"
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// When the approved bank runs out (e.g. "أسئلة أصعب" in a topic), the tutor
/// says so and logs demand here for the content team. It never shows
/// unreviewed generated questions to students.
model ContentGap {
  id              String   @id @default(cuid())
  topicId         String?
  difficulty      Int?
  kind            String // "harder_questions", "missing_explanation", "no_source"
  requests        Int      @default(1)
  lastRequestedAt DateTime @default(now())
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([topicId, difficulty, kind])
}

// =====================================================================
// 11. Commerce & audit
// =====================================================================

/// Kept after erasure (userId → NULL) for ZATCA invoice retention.
model Purchase {
  id           String          @id @default(cuid())
  userId       String?
  targetId     String? // validity is tied to an exam target (+ retake extension)
  product      String
  amountHalala Int
  vatHalala    Int
  provider     String // chosen gateway
  providerRef  String          @unique
  status       String
  validUntil   DateTime?
  createdAt    DateTime        @default(now())
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  target       UserExamTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
}

// =====================================================================
//  Outside Prisma (prisma/sql/search_and_guards.sql, applied after every
//  `prisma migrate deploy`, idempotent; tested by tests/schema_guards.sql):
//  - partial unique indexes: one correct option, one open placement, one live job
//  - CHECK constraints: publish gate, scoring gate, AI provenance
//  - schema `search`: question_index / chunk_index / extracted_index with
//    tsvector ('simple' config on the normalized key) + vector(1024) + HNSW
// =====================================================================
